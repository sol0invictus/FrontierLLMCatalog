// Cloudflare Workers Builds deploys this repo as the Worker "frontierllmcatalog".
// Serve the bundled site in dist/, and answer model paths (/<slug>, /compare/a-vs-b)
// with index.html instead of a 404.
{
  "name": "frontierllmcatalog",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
